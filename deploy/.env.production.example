# Copy this to .env on the droplet (APP_DIR/.env), fill in real values, then run docker compose.
# scp deploy/.env.production.example root@<droplet-ip>:/opt/kna-home-php/.env  (then edit in place)

APP_NAME=KNA Interpharma
APP_ENV=production
BASE_URL=http://YOUR_DROPLET_IP

# Must match docker-compose.yml service name "mysql" — do not use 127.0.0.1 here.
DB_HOST=mysql
DB_NAME=kna_site
DB_USER=root
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Uploads are stored in a Docker volume (persists across redeploys).
# Switch to S3 later if you need multi-server / CDN-backed storage.
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=
S3_URL=
